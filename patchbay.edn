; Example rules for monoblok.
;
; Each top-level form is (on SUBJECT-FILTER BODY). BODY runs whenever
; an incoming publish matches the filter.
;
; Reference for every operator, gate, and window descriptor lives in
; docs/. Quickref: docs/patchbay-cheatsheet.md (one-liners). Long
; form: docs/patchbay.md (prose + worked pipelines + costs).

; Opt in to last-value-cache streams for all subjects. Narrow this to the
; subject families you actually want retained in production.
(lvc [">"])

; Fan high temperature readings out to a dedicated sub-subject.
(on "sensors.*"
  (when (> payload-float 30.0)
    (publish! (subject-append "high") payload)))

; Mirror anything mentioning "alert" to events.alerts.
(on ">"
  (when (contains? payload "alert")
    (publish! "events.alerts" (str-concat subject ": " payload))))

; Squelch a noisy sensor: only re-publish when the value changes after
; rounding to 1 decimal place. Upstream may emit 42.01, 42.04, 42.08,
; 42.12 — we emit once at 42.0 and once at 42.1.
(on "sensors.*"
  (-> payload-float
      (round 1)
      (squelch)
      (publish! (subject-append "stable"))))

; Analog-style deadband: suppress changes smaller than 0.5.
(on "sensors.*"
  (-> payload-float
      (deadband 0.5)
      (publish! (subject-append "delta"))))

; Smooth a noisy stream with a 10-sample moving average, only emitting
; when the smoothed value drifts by >= 1.0.
(on "sensors.*"
  (-> payload-float
      (moving-avg 10)
      (deadband 1.0)
      (publish! (subject-append "smoothed"))))

; Time-windowed smoothing: 5-second sliding average. Old samples expire
; on the next push or the slot's exact deadline timer, whichever is sooner.
(on "sensors.*"
  (-> payload-float
      (moving-avg :ms 5000)
      (publish! (subject-append "avg5s"))))

; JSON device frame fan-out. This lets the rest of the patchbay treat
; devices.kitchen.temp and devices.kitchen.hum as normal scalar streams.
; :reentrant true lets the demuxed publishes feed the following rules.
(on "devices.*" :reentrant true
  (json-demux! "temp" "hum" "batt" payload))

; 1-minute aligned OHLC bars on a price stream. Bars close on the next
; tick that crosses a wall-clock minute boundary, or from the slot's
; exact deadline timer if the feed goes quiet.
;(on "MARKET.*"
;  (bar! :ms 60000 payload-float))

