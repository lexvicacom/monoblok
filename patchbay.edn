; Example rules for monoblok.
;
; Each top-level form is (on SUBJECT-FILTER BODY). BODY runs whenever
; an incoming publish matches the filter.
;
; Reference for every operator, gate, and window descriptor lives in
; docs/. Quickref: docs/patchbay-cheatsheet.md (one-liners). Long
; form: docs/patchbay.md (prose + worked pipelines + costs).

; Opt in to last-value-cache streams for all subjects. Narrow this to the
; subject families you actually want retained in production.
; nats pub foo 1
; ...
; nats sub '$LVC.foo' => 1
; nats pub foo 2
; ..
; => 2

(lvc [">"])

; It is recommended you nats sub '>' to see the outputs of the below
;
; Fan high temperature readings out to a dedicated sub-subject. nats pub sensors.temp 40
(on "sensors.*"
  (when (> payload-float 30.0)
    (publish! (subject-append "high") payload))) ; => sensors.temp.high

; Mirror anything mentioning "alert" to events.alerts.
(on ">"
  (when (contains? payload "alert")
    (publish! "events.alerts" (str-concat subject ": " payload))))

; Squelch a noisy sensor: only re-publish when the value changes after
; rounding to 1 decimal place. Upstream may emit 42.01, 42.04, 42.08,
; 42.12, we emit once at 42.0 and once at 42.1.
(on "sensors.*"
  (-> payload-float
      (round 1)
      (squelch)
      (publish! (subject-append "stable"))))

; Analog-style deadband: suppress changes smaller than 0.5.
(on "sensors.*"
  (-> payload-float
      (deadband 0.5)
      (publish! (subject-append "delta"))))

; Smooth a noisy stream with a 10-sample moving average, only emitting
; when the smoothed value drifts by >= 1.0.
(on "sensors.*"
  (-> payload-float
      (moving-avg 10)
      (deadband 1.0)
      (publish! (subject-append "smoothed"))))

; Time-windowed smoothing: 5-second sliding average. Old samples expire
; on the next push or the slot's exact deadline timer, whichever is sooner.
(on "sensors.*"
  (-> payload-float
      (moving-avg :ms 5000)
      (publish! (subject-append "avg5s"))))

; JSON device frame fan-out. This lets the rest of the patchbay treat
; devices.kitchen.temp and devices.kitchen.hum as normal scalar streams.
; :reentrant true lets the demuxed publishes feed the following rules.
(on "devices.*" :reentrant true
  (json-demux! "temp" "hum" "batt" payload))

; 1-minute aligned OHLC bars on a price stream. Bars close on the next
; tick that crosses a wall-clock minute boundary, or from the slot's
; exact deadline timer if the feed goes quiet.
;(on "MARKET.*"
;  (bar! :ms 60000 payload-float))

; Hysteresis: a single threshold chatters when a value hovers around it.
; (hysteresis LO HI X) is true once X >= HI, false once X <= LO, and holds
; its last answer in between, so transition fires once per real excursion.
; nats pub boiler.temp 20  => nothing (first sight never fires an edge)
; nats pub boiler.temp 29  => boiler.temp.alert "hot"
; nats pub boiler.temp 27  => nothing (inside the 26..28 band)
; nats pub boiler.temp 25  => boiler.temp.ok "cool"
(on "boiler.temp"
  (transition (hysteresis 26.0 28.0 payload-float)
    (publish! (subject-append "alert") "hot")
    (publish! (subject-append "ok")    "cool")))

; Funnel: patchbay state is per subject, so there is no shared state across
; subjects. To average room.kitchen.temp and room.office.temp together,
; republish both onto one subject with a :reentrant rule, then put the
; stateful rule on that subject.
; nats pub room.kitchen.temp 20 ; nats pub room.office.temp 22 => room.average 21.0
(on "room.*.temp" :reentrant true
  (publish! "room.all" payload))

(on "room.all"
  (publish! "room.average" :dp 1 (moving-avg 2 payload-float)))

; Last value: (last SUBJECT) reads the LVC (see (lvc ...) above), so it is
; a join with another subject. It is nil until that subject has a value, and
; a thread stops on nil, so nothing is published until both sides exist.
; nats pub room.office.temp 22 ; nats pub room.kitchen.temp 20.5
;   => room.kitchen.warmer-by -1.5
(on "room.kitchen.temp"
  (-> (last "room.office.temp")
      (- payload-float)
      (publish! "room.kitchen.warmer-by" :dp 1)))

; Reply: answer a request with a cached value. reply-to is the request's
; reply subject; (reply! VALUE) publishes to it, and does nothing if there
; is no reply subject or VALUE is nil.
; nats req ask.room.office ""  => 22
(on "ask.room.office"
  (reply! (last "room.office.temp")))

