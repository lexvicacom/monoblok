; Example rules for monoblok.
;
; Each top-level form is (on SUBJECT-FILTER BODY).
; BODY runs whenever an incoming publish subject matches the filter.
;
; Inside BODY:
;   subject       - bare symbol, evaluates to the incoming subject string
;   payload       - bare symbol, evaluates to the payload bytes
;   payload-float - bare symbol, parses payload as a float
;
;   (publish SUBJ PAYLOAD)
;   (subject-append SUFFIX)            - produces "SUBJECT.SUFFIX"
;   (str-concat A B C ...)
;   (when COND BODY...) / (if C T E) / (and ...) / (or ...) / (not X)
;   (= A B) / (> A B) / (< A B) / (>= A B) / (<= A B)
;   (+ ...) (- ...) (* ...) (/ ...)
;   (contains? HAYSTACK NEEDLE)
;   (round DECIMALS X)                  - round X to N decimal places
;   (quantize STEP X)                   - snap X to nearest multiple of STEP
;   (squelch X)                         - pass X through iff it differs from
;                                         last X seen (nil otherwise)
;   (deadband DELTA X)                  - pass X through iff changed by >= DELTA
;                                         (nil otherwise)
;   (hold-off MS X)                     - pass X through on first sight, then
;                                         suppress any further X for MS ms
;                                         (radar term: re-arm timer). Time is
;                                         the ingress wall-clock stamped once
;                                         per incoming publish.
;   (moving-avg N X)                    - running mean over last N samples
;   (moving-sum N X)                    - running sum over last N samples
;   (moving-max N X) / (moving-min N X) - window extremes
;   (json-get KEY PAYLOAD)              - top-level JSON object lookup,
;                                         returns the value as a number,
;                                         string, or boolean. Returns nil
;                                         for missing keys, malformed JSON,
;                                         or nested object/array values.
;                                         Value-last so it threads:
;                                         (-> payload (json-get "temp") ...)
;   (json-decode KEY ... PAYLOAD)       - demux a flat JSON frame: publish
;                                         each KEY's value to
;                                         <subject>.<key>. Skips missing,
;                                         null, and nested fields silently.
;   (ohlc-bar N X)                      - tick-count OHLC bar accumulator.
;                                         Every Nth tick, publishes
;                                         <subject>.bar.{open,high,low,
;                                         close} for the just-closed bar.
;                                         Returns nil. Per (rule, subject).
;
;   (-> X f1 f2 ...)                    - thread X through each form as its
;                                         last argument: (-> x (f 1) g)
;                                         expands to (g (f 1 x)). A gate
;                                         returning nil short-circuits any
;                                         downstream (publish-to ...).
;   (publish-to SUBJECT VALUE)          - like publish with args flipped,
;                                         no-op when VALUE is nil. Numbers
;                                         are formatted canonically.



; Fan high temperature readings out to a dedicated sub-subject.
(on "sensors.*"
  (when (> payload-float 30.0)
    (publish (subject-append "high") payload)))

; Mirror anything mentioning "alert" to events.alerts.
(on ">"
  (when (contains? payload "alert")
    (publish "events.alerts" (str-concat subject ": " payload))))

; Squelch a noisy sensor: only re-publish when the value changes after
; rounding to 1 decimal place. Upstream may emit 42.01, 42.04, 42.08,
; 42.12 — we emit once at 42.0 and once at 42.1.
(on "sensors.*"
  (-> payload-float
      (round 1)
      (squelch)
      (publish-to (subject-append "stable"))))

; Analog-style deadband: suppress changes smaller than 0.5.
(on "sensors.*"
  (-> payload-float
      (deadband 0.5)
      (publish-to (subject-append "delta"))))

; Smooth a noisy stream with a 10-sample moving average, only emitting
; when the smoothed value drifts by >= 1.0.
(on "sensors.*"
  (-> payload-float
      (moving-avg 10)
      (deadband 1.0)
      (publish-to (subject-append "smoothed"))))

; --- Outbound NATS bridge (example, commented out) ----------------------
;
; Zero or one `(bridge ...)` form, at top level. Forwards local publishes
; whose subject matches any `:export` filter to a remote NATS cluster via
; nats.c. Export-only: nothing flows in from the remote.
;
; Keywords:
;   :servers            list of server URLs (nats:// or tls://)
;   :name               optional client name (shown in remote monitoring)
;   :creds              path to a .creds file (JWT+NKey, as used with NGS)
;   :user / :password   basic auth
;   :token              bearer token auth
;   :tls                true/false. Required for tls:// URLs.
;   :tls-ca             path to a CA cert (PEM)
;   :tls-cert / :tls-key  client cert + private key (mTLS)
;   :tls-skip-verify    true/false. Dev only. Insecure.
;   :connect-timeout-ms / :ping-interval-ms
;   :max-reconnect      -1 for unlimited
;   :reconnect-wait-ms
;   :export             list of subject filters to forward. Standard
;                       NATS wildcards: `*` is one token, `>` is tail-
;                       only and matches one or more. Subject is sent
;                       to the remote as-is.
;
; Counters are published to `$STATS.bridge.published` / `.dropped` on the
; normal $STATS tick.
;
; (bridge
;   :servers  ("tls://a.example:4222" "tls://b.example:4222")
;   :creds    "/etc/monoblok/ngs.creds"
;   :tls      true
;   :name     "monoblok-prod-1"
;   :export   ("telemetry.>" "alerts.>"))
