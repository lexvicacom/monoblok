; Market ticker: clean up noisy prices and alert on big jumps.

; Round to 3 decimals, drop duplicates, emit on MARKET.<SYM>.stable.
(on "MARKET.*"
  (-> payload-float
      (round 3)
      (squelch)
      (publish! (subject-append "stable"))))

; Fan out big jumps (>= 1.0 move between consecutive ticks) to
; alerts.market.<SYM>. delta is 0 on first sight so this stays quiet
; until we have a prior value.
(on "MARKET.*"
  (when (>= (abs (delta payload-float)) 1.0)
    (publish!
      (str-concat "alerts.market." (subject-token 1))
      payload)))

; Forward all market alerts to the remote NATS server.
(bridge
  :servers ["nats://127.0.0.1:4222"]
  :name    "monoblok-ticker"
  :export  ["alerts.market.>"])
