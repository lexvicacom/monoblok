; JSON-emitting sensor: one off-the-shelf gateway publishes a flat
; frame like {"temp":12.5,"hum":80,"batt":3.7} on devices.<id>, and
; we want the rest of the patchbay to keep working in scalars.

; Step 1: break the frame out at the head. json-demux is a
; demultiplexer: one wire in, one sub-subject out per named field.
; The publish is implicit (the form has no return value), so this
; sits at the tail of the rule.
;   devices.kitchen {"temp":12.5,"hum":80} -> devices.kitchen.temp 12.5
;                                             devices.kitchen.hum  80
; Missing, null, array, and non-selected nested fields are skipped silently.
(on "devices.*" :reentrant true
  (json-demux! "temp" "hum" "batt" payload))

; Step 2: from here on, treat each fanned-out subject as a normal
; scalar stream. Round, deadband, publish to a "stable" mirror.
(on "devices.*.temp"
  (-> payload-float
      (round 1)
      (deadband 0.2)
      (publish! (subject-append "stable"))))

(on "devices.*.hum"
  (-> payload-float
      (round 0)
      (squelch)
      (publish! (subject-append "stable"))))

; Inline lookup: sometimes you only want one field from a frame and
; don't need the demux. Pull it straight off the JSON and into a
; threaded pipeline. json-get returns nil on missing/malformed/non-primitive,
; and publish! is a no-op on nil, so the rule self-skips bad frames.
(on "devices.*"
  (-> payload
      (json-get "batt")
      (publish! (subject-append "battery"))))
