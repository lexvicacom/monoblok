; Strict patchbay syntax:
;   (...) is always a call form and must start with a symbol.
;   [...] is the sequence/data form.

(lvc [">"])

(on "sensors.*"
  (when (contains? ["temp" "hum" "batt"] (subject-token 1))
    (publish! (subject-append "seen") payload)))

(bridge
  :servers ["nats://127.0.0.1:4223"]
  :export  ["sensors.>" "alerts.>"])
