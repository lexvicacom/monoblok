;; A WAF for NATS: three rules that decide which messages are allowed
;; through to the cluster.
;;
;; Publishers connect to monoblok instead of the cluster and publish
;; under `in.>`:
;;   in.event.<source>    free-form or JSON events
;;   in.reading.<device>  numeric readings
;;
;; Only `clean.>` and `waf.>` are meant to leave this box. Pair the file
;; with (export :export ["clean.>" "waf.>"]) or an (import ...) tap and
;; the raw `in.>` traffic never reaches the far side.

;; Payload scan. An event carrying a known-bad fragment is not
;; forwarded; its subject (never its payload) is reported on
;; `waf.blocked`. Everything else moves from in.event.* to clean.event.*.
(on "in.event.*"
  (if (or (contains? payload "<script")
          (contains? payload "${jndi:")
          (contains? payload "DROP TABLE"))
    (publish! "waf.blocked" subject)
    (publish! (str-concat "clean.event." (subject-token 2)) payload)))

;; Outlier gate. Forward a reading only while it sits at or below the
;; p99 of the last 100 readings from that device. The window includes
;; the current sample, so a reading that sets a new window maximum is
;; held back: about one message in a hundred on a steady device, every
;; message on a device whose readings only climb.
(on "in.reading.*"
  (when (<= payload-float (percentile 100 0.99 payload-float))
    (publish! (str-concat "clean.reading." (subject-token 2)) payload)))

;; Flood detection. State is per subject, so every publisher subject
;; gets its own five-second window for free. More than ten messages in
;; that window (a rate above 2 per second) publishes one "block"; the
;; first message after the subject has slowed down publishes one
;; "clear". The numbers are demo-sized; raise them for real traffic.
(on "in.*.*"
  (transition (> (rate :ms 5000 payload) 2)
    (publish! (str-concat "waf.flood." subject) "block")
    (publish! (str-concat "waf.flood." subject) "clear")))
