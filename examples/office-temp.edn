;; Round to 1dp, ignore wobbles under 0.3°C, republish for dashboards
(on "temp.*.*"
  (-> payload-float
      (round 1)
      (deadband 0.3)
      (publish! (subject-append "stable"))))

;; Sustained heat alert + all-clear in one rule: fire "alert" once when
;; the 60-sample moving average crosses above 28°C, "ok" once when it
;; drops back below. One predicate, one ring buffer, one prev slot.
(on "temp.*.*"
  (transition (> (moving-avg 60 payload-float) 28.0)
    (publish! (subject-append "alert") "hot")
    (publish! (subject-append "ok")    "cool")))

;; Daily heat-event tally: increment a per-sensor counter once on each
;; false->true crossing of the same threshold, ignoring all the
;; in-between samples. Subscribe to `temp.<floor>.<room>.count` for the
;; running total. (rising-edge fires once per transition, so this is a
;; counter of *crossings*, not samples.)
(on "temp.*.*"
  (count! (rising-edge (> (moving-avg 60 payload-float) 28.0))))
