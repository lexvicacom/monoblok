.{
    .name = .monoblok,
    .version = "0.0.46",
    .fingerprint = 0x92491acd12051406, // Changing this has security and trust implications.
    .minimum_zig_version = "0.16.0",
    .dependencies = .{
        .libxev = .{
            .url = "git+https://github.com/mitchellh/libxev#a82a04eabb46b0611c72d6d0e32db2d9dcf2e745",
            .hash = "libxev-0.0.0-86vtcwIRFACVrx54GaHsMFFlyC4dTi0tcVh10V7btRUc",
        },
        // Vendored at vendor/nats.zig (v0.1.0 + a one-line fcntl fix needed
        // for Zig 0.16; see vendor/nats.zig/src/Client.zig:106).
        .nats = .{ .path = "vendor/nats.zig" },
    },
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
        "vendor",
        "LICENSE",
        "README.md",
    },
}
